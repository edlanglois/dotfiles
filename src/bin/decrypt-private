#!/usr/bin/env bash
# Decrypt a private directory managed by eCryptfs using a key accessed through
# libsecret
set -euo pipefail

MOUNT_PASSPHRASE_SIG_FILE="$HOME/.ecryptfs/Private.sig"
WRAPPED_PASSPHRASE_FILE="$HOME/.ecryptfs/wrapped-passphrase"
MOUNT_POINT="$(cat "$HOME/.ecryptfs/Private.mnt" 2>/dev/null || echo "$HOME/Private")"

# Report errors on stderr, and also as a desktop notification if stderr is not
# a terminal (e.g. when run from a key binding) so that they are not missed.
fail () {
	>&2 printf "%s\n" "$@"
	if [ ! -t 2 ] && command -v notify-send >/dev/null; then
		notify-send -u critical "decrypt-private" "$(printf "%s\n" "$@")"
	fi
	exit 1
}

if mountpoint -q "$MOUNT_POINT"; then
	exit 0
fi

if ! LOGINPASS="$(secret-tool lookup account "private-key-$(hostname)")"; then
	fail "Could not find password in the secret manager." \
		"Make sure the secret manager is running and the password is stored with key \"account\" and value \"private-key-$(hostname)\"."
fi

if [ "$(wc -l < "$MOUNT_PASSPHRASE_SIG_FILE")" = "1" ]; then
	# No filename encryption
	if ! printf "%s\0" "$LOGINPASS" | ecryptfs-unwrap-passphrase "$WRAPPED_PASSPHRASE_FILE" - | ecryptfs-add-passphrase - >/dev/null; then
		fail "Could not add the mount passphrase to the keyring."
	fi
else
	# With filename encryption
	if ! printf "%s\0" "$LOGINPASS" | ecryptfs-insert-wrapped-passphrase-into-keyring "$WRAPPED_PASSPHRASE_FILE" - >/dev/null; then
		fail "Could not add the mount passphrase to the keyring."
	fi
fi

if ! MOUNT_OUTPUT="$(/sbin/mount.ecryptfs_private 2>&1)"; then
	fail "Failed to mount $MOUNT_POINT:" "$MOUNT_OUTPUT"
fi

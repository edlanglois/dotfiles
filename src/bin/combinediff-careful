#!/bin/bash
# combinediff but returns non-zero if anything went wrong
set -eu -o pipefail
stderrfile="$(mktemp)"
trap 'rm -f "$stderrfile"' EXIT

# Swap stdout and stderr so stderr can be copied to a file while still shown.
# Unlike >(...), the pipeline has finished writing when it returns.
{ combinediff "$@" 2>&1 1>&3 3>&- | tee "$stderrfile" >&2; } 3>&1

! [ -s "$stderrfile" ]

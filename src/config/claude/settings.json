{
  "theme": "auto",
  "permissions": {
    "deny": [
      "Read(~/.config/chromium/**)",
      "Read(~/.config/duplicacy/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/keepassxc/**)",
      "Read(~/.config/Slack/**)",
      "Read(~/.config/syncthing/**)",
      "Read(~/.duplicacy/**)",
      "Read(~/.duplicacy-web/**)",
      "Read(~/.ecryptfs/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.local/share/**)",
      "Read(~/.local/state/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.thunderbird/**)",
      "Read(~/Private/**)",
      "Read(~/Shared/**)",
      "Read(//**/*.kdbx)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*_history)",
      "Read(//**/.*_history)",
      "Read(//**/*credentials*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets.*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/black",
        "~/.cache/cargo",
        "~/.cache/go-build",
        "~/.cache/matplotlib",
        "~/.cache/mypy",
        "~/.cache/pip",
        "~/.cache/pre-commit",
        "~/.cache/prek",
        "~/.cache/ty",
        "~/.cache/uv"
      ],
      "denyRead": [
        "~/.config/chromium",
        "~/.config/claude/.credentials.json",
        "~/.config/duplicacy",
        "~/.config/google-chrome",
        "~/.config/keepassxc",
        "~/.config/Slack",
        "~/.config/syncthing",
        "~/.duplicacy",
        "~/.duplicacy-web",
        "~/.ecryptfs",
        "~/.git-credentials",
        "~/.gnupg",
        "~/.local/share/bash",
        "~/.local/share/fish",
        "~/.local/share/gnupg",
        "~/.local/share/keyrings",
        "~/.local/state/syncthing",
        "~/.mozilla",
        "~/.netrc",
        "~/.ssh",
        "~/.thunderbird",
        "~/Private",
        "~/Shared"
      ]
    }
  }
}

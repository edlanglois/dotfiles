{
  "theme": "auto",
  "permissions": {
    "deny": [
      "Read(~/.ecryptfs/**)",
      "Read(~/.ssh/**)",
      "Read(~/Private/**)",
      "Read(~/Shared/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/black",
        "~/.cache/cargo",
        "~/.cache/go-build",
        "~/.cache/matplotlib",
        "~/.cache/pip",
        "~/.cache/pre-commit",
        "~/.cache/prek",
        "~/.cache/ty",
        "~/.cache/uv"
      ],
      "denyRead": [
        "~/.ecryptfs",
        "~/.ssh",
        "~/Private",
        "~/Shared"
      ]
    }
  }
}

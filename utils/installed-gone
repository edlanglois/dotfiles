#!/usr/bin/env bash
# List installed files that have been removed from the dotfiles repo
set -eu
cd "$(dirname "$0")/.."

# Install locations and targets from the Makefile (which reads user.cfg)
VAR_NAMES=(
	HOME_DIR BIN_DIR CONFIG_DIR DATA_DIR SYSTEM_PREFIX
	INSTALL_TARGETS INSTALL_ONCE_TARGETS INSTALL_SYSTEM_TARGETS
)
declare -A MAKE_VAR
# The --eval rule prints NAME=value for print-NAME. Make expands its $s.
# shellcheck disable=SC2016
while IFS='=' read -r name value; do
	MAKE_VAR["$name"]="$value"
done < <(make -s --eval 'print-%: ; @echo "$*=$($*)"' "${VAR_NAMES[@]/#/print-}")
for name in "${VAR_NAMES[@]}"; do
	if [ -z "${MAKE_VAR["$name"]+set}" ]; then
		echo "Unable to read $name from the Makefile" >&2
		exit 1
	fi
done
HOME_DIR="${MAKE_VAR[HOME_DIR]}"
BIN_DIR="${MAKE_VAR[BIN_DIR]}"
CONFIG_DIR="${MAKE_VAR[CONFIG_DIR]}"
DATA_DIR="${MAKE_VAR[DATA_DIR]}"
SYSTEM_DIR="${MAKE_VAR[SYSTEM_PREFIX]%/}"

# Prints where a repo path is (or was) installed. Fails if it isn't installed.
install_path() {
	local path="$1" dir
	case "$path" in
		src/bin/*) dir="$BIN_DIR" ;;
		src/config/*) dir="$CONFIG_DIR" ;;
		src/data/*) dir="$DATA_DIR" ;;
		src/home/*) dir="$HOME_DIR" ;;
		src/system/*) dir="$SYSTEM_DIR" ;;
		src/*|.git*|.pre-commit-config.yaml) return 1 ;;
		# Older layout where the repository root mirrored the home directory
		.*) dir="$HOME_DIR"; path="src/home/$path" ;;
		*) return 1 ;;
	esac
	path="${path#src/*/}"
	path="${path%.m4}"
	path="${path%.link}"
	path="${path%.dlink}"
	path="${path%.sed}"
	echo "$dir/$path"
}

# Everything that is still installed
declare -A CURRENT
# Unquoted to split the space-separated target lists
# shellcheck disable=SC2086
for target in \
	${MAKE_VAR[INSTALL_TARGETS]} \
	${MAKE_VAR[INSTALL_ONCE_TARGETS]} \
	${MAKE_VAR[INSTALL_SYSTEM_TARGETS]}
do
	CURRENT["${target%/.}"]=1
done
while IFS= read -r path; do
	if installed="$(install_path "$path")"; then
		CURRENT["$installed"]=1
	fi
done < <(git ls-files src)

# Files that have been removed from the repo at some point
git log --diff-filter=D --no-renames --name-only --format= | sort -u |
	while IFS= read -r path; do
		if installed="$(install_path "$path")" &&
			[ -z "${CURRENT["$installed"]:-}" ] &&
			{ [ -e "$installed" ] || [ -L "$installed" ]; }; then
			echo "$installed"
		fi
	done | sort -u
